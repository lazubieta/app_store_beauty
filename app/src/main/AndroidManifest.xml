<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required by the system -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".AuraBeautyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraBeauty"
        tools:targetApi="31">

        <!-- Splash Screen (Launcher Activity) -->
        <activity
            android:name=".ui.auth.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Flow -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.auth.RecoverPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <!-- Buyer Flow Activities -->
        <activity
            android:name=".ui.buyer.BuyerMainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.buyer.ProductDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.buyer.SecurePaymentActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.buyer.OrderTrackingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <!-- Seller Flow Activities -->
        <activity
            android:name=".ui.seller.SellerMainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.seller.AddProductActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.seller.EditProductActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <!-- Administrator Flow Activities -->
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

        <activity
            android:name=".ui.admin.UserDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AuraBeauty.NoActionBar" />

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Title -->
    <TextView
        android:id="@+id/tvSellerOrdersTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingEnd="@dimen/spacing_standard"
        android:paddingBottom="@dimen/spacing_small"
        android:text="@string/title_orders_received"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_headline"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Orders RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSellerOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSellerOrdersTitle" />

</androidx.constraintlayout.widget.ConstraintLayout>

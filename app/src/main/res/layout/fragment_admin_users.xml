<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header Titles -->
    <LinearLayout
        android:id="@+id/headerAdminUsers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_manage_users"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="@string/subtitle_manage_users"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

    </LinearLayout>

    <!-- Search Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearchAdminUsers"
        style="@style/Widget.AuraBeauty.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_standard"
        app:cardCornerRadius="@dimen/corner_radius_pill"
        app:layout_constraintTop_toBottomOf="@+id/headerAdminUsers"
        app:strokeColor="@color/surface_card_stroke">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_standard"
            android:paddingEnd="@dimen/spacing_standard">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Buscar"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/etSearchAdminUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:background="@null"
                android:hint="@string/search_hint_users"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="@dimen/text_size_body" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Filter Chips (Todos / Compradores / Vendedores) -->
    <LinearLayout
        android:id="@+id/layoutAdminUserFilterChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/cardSearchAdminUsers">

        <TextView
            android:id="@+id/chipAdminAllUsers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_selected"
            android:text="@string/tab_all_users"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipAdminBuyers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:background="@drawable/bg_chip_unselected"
            android:text="@string/tab_buyers"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

        <TextView
            android:id="@+id/chipAdminSellers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_small"
            android:background="@drawable/bg_chip_unselected"
            android:text="@string/tab_sellers"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

    </LinearLayout>

    <!-- Users RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutAdminUserFilterChips" />

</androidx.constraintlayout.widget.ConstraintLayout>

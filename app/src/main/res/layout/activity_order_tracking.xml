<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTracking"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackTracking"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnOrderTrackingViewDetail"
        app:layout_constraintTop_toBottomOf="@+id/toolbarTracking">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xlarge">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_order_tracking"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <!-- Vertical Tracking Timeline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical">

                <!-- Step 1: Pedido confirmado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_timeline_dot_completed"
                            android:contentDescription="Confirmado"
                            android:padding="4dp"
                            android:src="@drawable/ic_check" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="@color/secondary_mint" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_standard"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/order_step_confirmed"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="@string/order_step_confirmed_date"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 2: En preparación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_timeline_dot_completed"
                            android:contentDescription="Preparación"
                            android:padding="4dp"
                            android:src="@drawable/ic_check" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="@color/secondary_mint" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_standard"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/order_step_preparing"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="@string/order_step_preparing_date"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 3: En camino (Active) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_timeline_dot_active" />

                        <View
                            android:layout_width="2dp"
                            android:layout_height="40dp"
                            android:background="@color/divider_color" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_standard"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/order_step_on_way"
                            android:textColor="@color/primary_dark"
                            android:textSize="@dimen/text_size_body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/order_step_on_way_desc"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_caption" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="@string/order_step_on_way_date"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_caption" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 4: Entregado (Pending) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_timeline_dot_pending" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_standard"
                        android:text="@string/order_step_delivered"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_size_body" />

                </LinearLayout>

            </LinearLayout>

            <!-- Simulated Map Card with ETA -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.AuraBeauty.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                app:cardCornerRadius="@dimen/corner_radius_card"
                app:cardElevation="@dimen/elevation_low"
                app:strokeColor="@color/surface_card_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <!-- Simulated Map visual bar with route and truck -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_banner_buyer">

                        <ImageView
                            android:id="@+id/ivMapPin"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="@dimen/spacing_xlarge"
                            android:contentDescription="Punto de entrega"
                            android:src="@drawable/ic_truck"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="3dp"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:background="@color/primary"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/ivMapTruck"
                            app:layout_constraintStart_toEndOf="@+id/ivMapPin"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivMapTruck"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="@dimen/spacing_xlarge"
                            android:contentDescription="Camión en camino"
                            android:src="@drawable/ic_truck"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- ETA Text -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/order_tracking_banner_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxsmall"
                        android:text="@string/order_tracking_banner_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Legal note (Derecho de retracto - Ley 1480 de 2011) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:text="@string/legal_right_of_withdrawal"
                android:textColor="@color/text_hint"
                android:textSize="@dimen/text_size_caption" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky Bottom View Detail Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOrderTrackingViewDetail"
        style="@style/Widget.AuraBeauty.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_standard"
        android:text="@string/btn_order_view_detail"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.AuraBeauty.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_xsmall"
    android:layout_marginBottom="@dimen/spacing_xsmall"
    app:cardCornerRadius="@dimen/corner_radius_card"
    app:cardElevation="@dimen/elevation_low"
    app:strokeColor="@color/surface_card_stroke">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <!-- Product Thumb -->
        <ImageView
            android:id="@+id/ivAdminProductThumb"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_dashed_photo_placeholder"
            android:contentDescription="Miniatura"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_giraffe_mascot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Name -->
        <TextView
            android:id="@+id/tvAdminProductName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/spacing_small"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Labial Velvet"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_body"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvAdminProductStatusBadge"
            app:layout_constraintStart_toEndOf="@+id/ivAdminProductThumb"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Category subtitle -->
        <TextView
            android:id="@+id/tvAdminProductCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="Maquillaje • Labiales"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption"
            app:layout_constraintEnd_toStartOf="@+id/tvAdminProductStatusBadge"
            app:layout_constraintStart_toEndOf="@+id/ivAdminProductThumb"
            app:layout_constraintTop_toBottomOf="@+id/tvAdminProductName" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvAdminProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="$ 39.900"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/ivAdminProductThumb"
            app:layout_constraintTop_toBottomOf="@+id/tvAdminProductCategory" />

        <!-- Status Chip Badge (Activo / Agotado) -->
        <TextView
            android:id="@+id/tvAdminProductStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_small"
            android:background="@drawable/bg_badge_active"
            android:text="Activo"
            android:textColor="@color/status_active_text"
            android:textSize="@dimen/text_size_caption"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnAdminEditProduct"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Edit Button -->
        <ImageButton
            android:id="@+id/btnAdminEditProduct"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar"
            android:src="@drawable/ic_edit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnAdminProductOptions"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Options Button -->
        <ImageButton
            android:id="@+id/btnAdminProductOptions"
            android:layout_width="32dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAddProduct"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackAddProduct"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/title_new_product"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btnSaveNewProduct"
        app:layout_constraintTop_toBottomOf="@+id/toolbarAddProduct">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xlarge">

            <!-- Camera Upload Photo Box -->
            <FrameLayout
                android:id="@+id/boxAddProductPhoto"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:background="@drawable/bg_dashed_photo_placeholder"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivAddProductPreview"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@string/btn_add_photo"
                        android:src="@drawable/ic_camera" />

                    <TextView
                        android:id="@+id/tvAddPhotoLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="@string/btn_add_photo"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />

                </LinearLayout>

            </FrameLayout>

            <!-- Product Name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddProductName"
                style="@style/Widget.AuraBeauty.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:hint="@string/label_product_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Brand Selection Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/label_brand"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <Spinner
                android:id="@+id/spinnerAddProductBrand"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:background="@drawable/bg_chip_unselected" />

            <!-- Category Selection Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/label_category"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <Spinner
                android:id="@+id/spinnerAddProductCategory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:background="@drawable/bg_chip_unselected" />

            <!-- Tone -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAddProductTone"
                style="@style/Widget.AuraBeauty.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:hint="@string/label_tone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddProductTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Price & Stock Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAddProductPrice"
                    style="@style/Widget.AuraBeauty.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:hint="@string/label_price">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddProductPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAddProductStock"
                    style="@style/Widget.AuraBeauty.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:layout_weight="1"
                    android:hint="@string/label_stock">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAddProductStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/text_primary" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Save Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveNewProduct"
        style="@style/Widget.AuraBeauty.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_standard"
        android:text="@string/btn_save_product"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

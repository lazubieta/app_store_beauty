<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Header Titles -->
    <LinearLayout
        android:id="@+id/headerAdminProducts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_admin_manage_products"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_headline"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="@string/subtitle_admin_manage_products"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

    </LinearLayout>

    <!-- Search Bar & Category Filter Row -->
    <LinearLayout
        android:id="@+id/layoutAdminProductSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_standard"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/spacing_standard"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/headerAdminProducts">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AuraBeauty.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardCornerRadius="@dimen/corner_radius_pill"
            app:strokeColor="@color/surface_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearchAdminProduct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_small"
                    android:background="@null"
                    android:hint="Buscar producto"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_size_caption" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Category Dropdown Chip -->
        <TextView
            android:id="@+id/tvAdminCategoryFilter"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/spacing_small"
            android:background="@drawable/bg_chip_unselected"
            android:gravity="center"
            android:paddingStart="@dimen/spacing_medium"
            android:paddingEnd="@dimen/spacing_medium"
            android:text="Categoría ▼"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_caption" />

    </LinearLayout>

    <!-- Admin Products RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_small"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintBottom_toTopOf="@+id/btnAdminReviewProduct"
        app:layout_constraintTop_toBottomOf="@+id/layoutAdminProductSearch" />

    <!-- Bottom Sticky Button: Revisar producto -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdminReviewProduct"
        style="@style/Widget.AuraBeauty.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_standard"
        android:text="@string/btn_review_product"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        android:paddingBottom="@dimen/spacing_xxlarge">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:text="@string/admin_panel_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_display"
            android:textStyle="bold" />

        <!-- Saludo -->
        <TextView
            android:id="@+id/tvAdminGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="@string/admin_greeting"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxsmall"
            android:text="@string/admin_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_body" />

        <!-- 4 KPI Cards Grid (2x2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_standard"
            android:orientation="vertical">

            <!-- Row 1: Usuarios & Productos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- KPI Usuarios -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AuraBeauty.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:strokeColor="@color/surface_card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Usuarios"
                                android:src="@drawable/ic_users"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xsmall"
                                android:text="@string/kpi_admin_users"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_caption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAdminKpiUsers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:text="@string/kpi_admin_users_value"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kpi_admin_users_growth"
                            android:textColor="@color/secondary_mint_dark"
                            android:textSize="@dimen/text_size_micro"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- KPI Productos -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AuraBeauty.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:strokeColor="@color/surface_card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Productos"
                                android:src="@drawable/ic_orders"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xsmall"
                                android:text="@string/kpi_admin_products"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_caption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAdminKpiProducts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:text="@string/kpi_admin_products_value"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kpi_admin_products_growth"
                            android:textColor="@color/secondary_mint_dark"
                            android:textSize="@dimen/text_size_micro"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Row 2: Ventas & Alertas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:orientation="horizontal">

                <!-- KPI Ventas -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AuraBeauty.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:strokeColor="@color/surface_card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Ventas"
                                android:src="@drawable/ic_payments"
                                app:tint="@color/status_pending_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xsmall"
                                android:text="@string/kpi_admin_sales"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_caption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAdminKpiSales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:text="@string/kpi_admin_sales_value"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/kpi_admin_sales_growth"
                            android:textColor="@color/secondary_mint_dark"
                            android:textSize="@dimen/text_size_micro"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- KPI Alertas -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.AuraBeauty.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    app:cardCornerRadius="@dimen/corner_radius_card"
                    app:strokeColor="@color/surface_card_stroke">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_medium">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Alertas"
                                android:src="@drawable/ic_favorites"
                                app:tint="@color/status_blocked_text" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xsmall"
                                android:text="@string/kpi_admin_alerts"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_size_caption" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAdminKpiAlerts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xsmall"
                            android:text="@string/kpi_admin_alerts_value"
                            android:textColor="@color/status_blocked_text"
                            android:textSize="@dimen/text_size_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↑ 2%"
                            android:textColor="@color/status_blocked_text"
                            android:textSize="@dimen/text_size_micro"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Sales Chart Card (Ventas de los últimos 7 días) -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.AuraBeauty.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_standard"
            app:cardCornerRadius="@dimen/corner_radius_card"
            app:strokeColor="@color/surface_card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <!-- Header of Chart -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_sales_chart"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_size_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="@string/filter_this_week"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_size_caption" />

                </LinearLayout>

                <!-- Visual Bar Chart -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/chart_bar_max_height"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <!-- Lun -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Lun"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                    <!-- Mar -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="65dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Mar"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                    <!-- Mié -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="35dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Mié"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                    <!-- Jue -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Jue"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                    <!-- Vie -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Vie"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                    <!-- Sáb -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Sáb"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                    <!-- Dom -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="bottom|center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="70dp"
                            android:background="@drawable/bg_chart_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xxsmall"
                            android:text="Dom"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_size_micro" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Section: Acciones rápidas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:text="@string/section_quick_actions"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

        <!-- 4 Action Buttons in a Grid (2x2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAdminUsers"
                    style="@style/Widget.AuraBeauty.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    android:text="@string/btn_admin_manage_users"
                    android:textSize="@dimen/text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAdminProducts"
                    style="@style/Widget.AuraBeauty.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    android:text="@string/btn_admin_manage_products"
                    android:textSize="@dimen/text_size_caption" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAdminAudit"
                    style="@style/Widget.AuraBeauty.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    android:text="@string/btn_admin_audit"
                    android:textSize="@dimen/text_size_caption" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickAdminReports"
                    style="@style/Widget.AuraBeauty.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xsmall"
                    android:layout_weight="1"
                    android:text="@string/btn_admin_reports"
                    android:textSize="@dimen/text_size_caption" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

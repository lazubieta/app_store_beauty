<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarUserDetail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="@dimen/spacing_standard"
        android:paddingEnd="@dimen/spacing_standard"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackUserDetail"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/title_user_detail"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable Form -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/layoutUserDetailButtons"
        app:layout_constraintTop_toBottomOf="@+id/toolbarUserDetail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xlarge">

            <!-- Avatar -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/avatar_size_large"
                android:layout_height="@dimen/avatar_size_large"
                app:cardCornerRadius="44dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/ivDetailUserAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Avatar"
                    android:padding="@dimen/spacing_medium"
                    android:src="@drawable/ic_profile" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Name -->
            <TextView
                android:id="@+id/tvDetailUserFullName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="Laura Gómez"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_size_headline"
                android:textStyle="bold" />

            <!-- Role subtitle -->
            <TextView
                android:id="@+id/tvDetailUserRoleSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxsmall"
                android:text="Compradora"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_body" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvDetailUserStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:background="@drawable/bg_badge_blocked"
                android:text="Bloqueado"
                android:textColor="@color/status_blocked_text"
                android:textSize="@dimen/text_size_caption"
                android:textStyle="bold" />

            <!-- Input: Nombre -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDetailUserName"
                style="@style/Widget.AuraBeauty.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:hint="@string/label_full_name"
                app:startIconDrawable="@drawable/ic_profile">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDetailUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:textColor="@color/text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input: Correo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDetailUserEmail"
                style="@style/Widget.AuraBeauty.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:hint="@string/label_email"
                app:startIconDrawable="@drawable/ic_profile">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDetailUserEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Spinner: Rol -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="Rol en plataforma"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <Spinner
                android:id="@+id/spinnerDetailUserRole"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:background="@drawable/bg_chip_unselected" />

            <!-- Spinner: Estado de cuenta -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:text="@string/label_account_status"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_size_caption" />

            <Spinner
                android:id="@+id/spinnerDetailUserStatus"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_field_height"
                android:layout_marginTop="@dimen/spacing_xsmall"
                android:background="@drawable/bg_chip_unselected" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutUserDetailButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_standard"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleBlockUser"
            style="@style/Widget.AuraBeauty.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_block_user" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveUserDetailChanges"
            style="@style/Widget.AuraBeauty.Button.Mint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xsmall"
            android:text="@string/btn_save_changes" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
